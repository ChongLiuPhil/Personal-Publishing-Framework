{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "replace-with-project-worker",
  "main": "password_gate.mjs",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./_book",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      // Replace with a unique positive integer per account/project.
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
