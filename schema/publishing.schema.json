{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ppf/publishing.schema.json",
  "title": "Personal Publishing Framework publication contract",
  "description": "Draft schema for PPF v0.1 publishing.yaml files.",
  "type": "object",
  "required": [
    "schema",
    "project",
    "source",
    "publication"
  ],
  "properties": {
    "schema": {
      "const": "ppf/v0.1"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": [
        "canonical"
      ],
      "properties": {
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "public",
            "private",
            "restricted"
          ]
        }
      },
      "additionalProperties": true
    },
    "publication": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "format",
          "mode",
          "enabled"
        ],
        "properties": {
          "format": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "continuous",
              "on-demand"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "authorization_state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "unresolved",
              "authorized",
              "not-authorized",
              "not-applicable"
            ]
          },
          "visibility": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "public",
              "restricted",
              "private"
            ]
          },
          "access": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "none",
                  "authenticated",
                  "selected-audience",
                  "other"
                ]
              },
              "implementation": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "policy_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "web": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "enabled": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "output_directory": {
              "type": "string",
              "minLength": 1
            },
            "production_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "integration_mode": {
              "type": "string",
              "enum": [
                "workers-builds-git",
                "github-actions-wrangler",
                "other"
              ]
            },
            "build_contract": {
              "type": [
                "string",
                "null"
              ]
            },
            "canonical_publish_gate": {
              "type": [
                "string",
                "null"
              ]
            },
            "readiness": {
              "type": "object",
              "properties": {
                "cloudflare_account": {
                  "type": "string"
                },
                "github_app": {
                  "type": "string"
                },
                "repository_connection": {
                  "type": "string"
                },
                "worker_target": {
                  "type": "string"
                },
                "production_trigger": {
                  "type": "string"
                },
                "preview_trigger": {
                  "type": "string"
                },
                "build_token": {
                  "type": "string"
                },
                "first_preview_build": {
                  "type": "string"
                },
                "production_cutover": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "current_provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "target_provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "current_production_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "target_production_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "migration_status": {
              "type": [
                "string",
                "null"
              ]
            },
            "integration_state": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "DECLARED",
                "REPOSITORY_VALIDATED",
                "ACCOUNT_CONNECTED",
                "PROVIDER_BUILD_VERIFIED",
                "PREVIEW_RUNTIME_VERIFIED",
                "CUTOVER_READY",
                "PRODUCTION_ACTIVE"
              ]
            },
            "authorization_state": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "UNRESOLVED",
                "HUMAN_AUTHORIZATION_REQUIRED",
                "AUTHORIZED",
                "NOT_APPLICABLE"
              ]
            },
            "cutover_state": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "BLOCKED",
                "PENDING",
                "READY",
                "ACTIVE"
              ]
            },
            "legacy_url_policy": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                null,
                "unresolved",
                "mirror",
                "legacy-with-canonical",
                "redirect",
                "retire"
              ]
            },
            "observed_state_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider_url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "canonical_identity": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    null,
                    "provider-native",
                    "custom-domain",
                    "other"
                  ]
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "release": {
      "type": "object",
      "properties": {
        "require_explicit_release": {
          "type": "boolean"
        },
        "continuous_web_is_release": {
          "type": "boolean"
        },
        "versioning": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "archive": {
      "type": "object",
      "additionalProperties": true
    },
    "framework": {
      "type": "object",
      "required": [
        "source",
        "adopted_version",
        "adopted_commit"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "adopted_version": {
          "type": "string",
          "minLength": 1
        },
        "adopted_commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "reference_implementation": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "adopted_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "adopted_commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-fA-F]{7,40}$"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": [
          "deployment"
        ],
        "properties": {
          "deployment": {
            "required": [
              "web"
            ],
            "properties": {
              "web": {
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "publication": {
            "required": [
              "web"
            ],
            "properties": {
              "web": {
                "required": [
                  "authorization_state"
                ],
                "properties": {
                  "authorization_state": {
                    "const": "authorized"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
