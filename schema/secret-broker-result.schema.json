{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ChongLiuPhil/Personal-Publishing-Framework/main/schema/secret-broker-result.schema.json",
  "title": "PPF secret broker result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "repository",
    "workerId",
    "installedSecretNames",
    "secretMetadataVerified",
    "plaintextReturned",
    "rollbackState"
  ],
  "properties": {
    "schema": {
      "const": "ppf/secret-broker-result/v1"
    },
    "status": {
      "enum": [
        "INSTALLED",
        "BLOCKED",
        "ROLLED_BACK",
        "ROLLBACK_INCOMPLETE"
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "workerId": {
      "type": "string",
      "minLength": 1
    },
    "tokenId": {
      "type": "string",
      "minLength": 1
    },
    "installedSecretNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "CLOUDFLARE_API_TOKEN",
          "CLOUDFLARE_ACCOUNT_ID"
        ]
      }
    },
    "secretMetadataVerified": {
      "type": "boolean"
    },
    "plaintextReturned": {
      "const": false
    },
    "rollbackState": {
      "enum": [
        "not-required",
        "completed",
        "incomplete"
      ]
    },
    "error": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "rollbackErrors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9:_-]+$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "INSTALLED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "tokenId"
        ],
        "properties": {
          "installedSecretNames": {
            "minItems": 2,
            "maxItems": 2
          },
          "secretMetadataVerified": {
            "const": true
          },
          "rollbackState": {
            "const": "not-required"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ROLLED_BACK"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "secretMetadataVerified": {
            "const": false
          },
          "rollbackState": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ROLLBACK_INCOMPLETE"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "rollbackErrors"
        ],
        "properties": {
          "secretMetadataVerified": {
            "const": false
          },
          "rollbackState": {
            "const": "incomplete"
          }
        }
      }
    }
  ]
}
