{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ChongLiuPhil/Personal-Publishing-Framework/main/schema/secret-broker-request.schema.json",
  "title": "PPF secret broker request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider",
    "tokenOwner",
    "credential",
    "target",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": "ppf/secret-broker-request/v1"
    },
    "provider": {
      "const": "cloudflare"
    },
    "tokenOwner": {
      "const": "account"
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "workerId",
        "workerName",
        "role"
      ],
      "properties": {
        "scope": {
          "const": "individual-worker"
        },
        "workerId": {
          "type": "string",
          "minLength": 1
        },
        "workerName": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "role": {
          "const": "Editor"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "secretNames"
      ],
      "properties": {
        "provider": {
          "const": "github-actions"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "secretNames": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              "CLOUDFLARE_API_TOKEN",
              "CLOUDFLARE_ACCOUNT_ID"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "CLOUDFLARE_API_TOKEN"
              }
            },
            {
              "contains": {
                "const": "CLOUDFLARE_ACCOUNT_ID"
              }
            }
          ]
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plaintextMustNotEnterModelContext",
        "plaintextMustNotEnterGit",
        "discardPlaintextAfterEncryptedWrite",
        "existingSecretsMustNotBeOverwritten",
        "rollbackMustRevokeMintedToken"
      ],
      "properties": {
        "plaintextMustNotEnterModelContext": {
          "const": true
        },
        "plaintextMustNotEnterGit": {
          "const": true
        },
        "discardPlaintextAfterEncryptedWrite": {
          "const": true
        },
        "existingSecretsMustNotBeOverwritten": {
          "const": true
        },
        "rollbackMustRevokeMintedToken": {
          "const": true
        }
      }
    }
  }
}
